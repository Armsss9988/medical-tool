{
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/safety-guard.cjs",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "typecheck-stop-guard": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node .agents/hooks/stop-guard.cjs",
        "timeout": 45
      }
    ]
  }
}
