{
  "name": "medical-tool",
  "version": "1.0.0",
  "description": "Phần mềm nhập kết quả xét nghiệm y tế đơn giản trên Desktop với QR Code và Excel",
  "main": "electron/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "npx -p eslint@9.20.0 -p @typescript-eslint/parser@8.24.0 -p @typescript-eslint/eslint-plugin@8.24.0 -p eslint-plugin-react@7.37.4 -p eslint-plugin-react-hooks@5.1.0 -p eslint-plugin-boundaries@5.0.1 eslint -c eslint.config.cjs src --max-warnings 0",
    "check": "npm run typecheck && npm run lint",
    "dev:vite": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "pack:portable": "npm run build && npx electron-builder --win"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.4.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3",
    "vite": "^6.3.1"
  }
}