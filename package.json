{
  "name": "medical-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @golab/web",
    "build": "npm run typecheck && npm run build -w @golab/web",
    "typecheck": "tsc --noEmit && npm run typecheck -w @golab/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "preview": "npm run preview -w @golab/web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
