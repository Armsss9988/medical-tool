VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# =================================================================
# CẤU HÌNH ZALO ZNS (ZALO NOTIFICATION SERVICE - OFFICIAL ACCOUNT)
# =================================================================
# 1. Bật/tắt chế độ Zalo ZNS (true / false)
VITE_ZALO_ENABLED=false

# 2. Thông tin Zalo App & OA ID từ developers.zalo.me & oa.zalo.me
VITE_ZALO_APP_ID=
VITE_ZALO_SECRET_KEY=
VITE_ZALO_OA_ID=

# 3. Access Token & Refresh Token (Dùng để gửi tin và tự động gia hạn token)
VITE_ZALO_ACCESS_TOKEN=
VITE_ZALO_REFRESH_TOKEN=

# 4. ID Mẫu tin nhắn ZNS đã được Zalo duyệt (Template ID từ zns.oa.zalo.me)
VITE_ZALO_TEMPLATE_ID=

# 5. Tự động gửi Zalo ZNS ngay sau khi bấm "Xuất PDF & Lưu Cloud (1-Click)"
VITE_ZALO_AUTO_SEND=false

# 6. Proxy URL (Tùy chọn: URL Supabase Edge Function hoặc backend trung gian nếu chạy web)
VITE_ZALO_PROXY_URL=

# =================================================================
# GoLab API (apps/api — Hono + Drizzle)
# =================================================================
# Connection string TRANSACTION MODE (Supavisor, port 6543) từ Supabase:
#   Project Settings → Database → Connection string → Transaction pooler.
#   PHẢI dùng port 6543 (transaction), KHÔNG dùng port 5432 (session) khi chạy trên serverless.
DATABASE_URL=postgresql://postgres.XXXX.supabase.co:6543/postgres
# Mật khẩu gate API — gửi qua header: x-app-password
APP_ACCESS_PASSWORD=change-me

# =================================================================
# GoLab Web (apps/web — Vite React)
# =================================================================
# Base URL cho API client. Mặc định "/api" (same-origin, dùng rewrite ở trên).
# Chỉ set khi KHÔNG dùng rewrite: ví dụ https://<api-project>.vercel.app
VITE_API_BASE_URL=/api
