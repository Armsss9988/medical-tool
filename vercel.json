{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**": {
      "runtime": "nodejs20.x",
      "maxDuration": 30,
      "includeFiles": "dist/api/**"
    }
  }
}
